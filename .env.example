# =====================================================================
#  BarrierFix: environment configuration
# ---------------------------------------------------------------------
#  Copy this file to `.env` (in this same folder) and fill in the values.
#  The API server AND the React client both read this one file.
#  Only variables starting with VITE_ are sent to the browser, so never
#  put a secret in a VITE_ variable.
# =====================================================================

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
NODE_ENV=development
# Port for the API server. Hosting platforms that set PORT themselves can leave this blank.
API_PORT=4000
# Public URL of the web app (used in email links and Slack messages)
APP_URL=http://localhost:5173
# Public URL of this API server. Slack must be able to reach it over HTTPS
# (in development use a tunnel such as ngrok or Cloudflare Tunnel).
API_PUBLIC_URL=http://localhost:4000
# Long random secret used to sign the Slack OAuth state and other short-lived tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# 64 hex characters (32 bytes) used to encrypt Slack tokens at rest. Generate the same way.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------
# Production: MongoDB Atlas connection string (create the cluster in the London region, eu-west-2)
#   e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/barrierfix?retryWrites=true&w=majority
# Development: "memory" runs an embedded MongoDB that is saved under server/.data/mongo
MONGODB_URI=memory

# ---------------------------------------------------------------------
# Firebase Authentication
# ---------------------------------------------------------------------
# Client values: Firebase console > Project settings > General > Your apps > Web app > SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server values: Firebase console > Project settings > Service accounts > Generate new private key.
# Copy project_id, client_email and private_key from the downloaded JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n sequences exactly as they appear in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Local Firebase emulator, for development ONLY. Leave BOTH blank once you use a real Firebase project.
FIREBASE_AUTH_EMULATOR_HOST=
VITE_FIREBASE_AUTH_EMULATOR_URL=

# ---------------------------------------------------------------------
# Platform admins (internal SimpliAccess team)
# ---------------------------------------------------------------------
# Comma-separated emails that get the Platform Admin role when they sign in.
# Nobody can register themselves, so create each sign-in once with:
#   npm run create-platform-admin -- someone@simpliaccess.co.uk
# (in development the account is created automatically when the server starts).
# These addresses are emailed when a company sends the "Request an account" form. Platform admins approve
# requests under Platform > Company requests, which creates the company (with its BF-000001 style
# Organisation ID) and its first admin.
PLATFORM_ADMIN_EMAILS=

# ---------------------------------------------------------------------
# Plans (no payment gateway in the MVP; Platform Admins change plans by hand)
# ---------------------------------------------------------------------
# Plan given to newly created companies (the Platform Admin can pick another): starter | professional | enterprise
DEFAULT_PLAN=professional

# ---------------------------------------------------------------------
# Email (SMTP): Postmark, SendGrid, Amazon SES, Google Workspace SMTP, etc.
# Firebase sends the sign-up verification and password-reset emails itself.
# This SMTP account sends everything else: optional login details, alerts, reviews, digests.
# Leave SMTP_HOST blank in development: emails are captured in the in-app Dev mailbox.
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BarrierFix <no-reply@simpliaccess.co.uk>"

# ---------------------------------------------------------------------
# Slack (api.slack.com/apps > your app > Basic Information / OAuth & Permissions)
# Leave blank to run without Slack; the web app works on its own.
# ---------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------
# Data retention (from the business plan, Table 8)
# ---------------------------------------------------------------------
BRIEF_RETENTION_DAYS=30
RECORD_RETENTION_MONTHS_AFTER_EMPLOYMENT=18
REVIEW_RETENTION_MONTHS=24

# Days before a manager is reminded about an open or incomplete Decision Record
DECISION_REMINDER_DAYS=3
# Days after a review opens before anyone who has not answered it gets one reminder.
REVIEW_REMINDER_DAYS=3

# ---------------------------------------------------------------------
# UK bank holidays feed (used for working-day deadlines and check-ins)
# ---------------------------------------------------------------------
BANK_HOLIDAYS_URL=https://www.gov.uk/bank-holidays.json
